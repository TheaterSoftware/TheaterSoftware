function createSeats(): Seat[] {
  const seats: Seat[] = [];
  let id = 1;

  for (let row = 1; row <= 7; row++) {
    for (let number = 1; number <= 12; number++) {
      seats.push({
        id,
        row_number: row,
        seat_number: number,
        side: number >= 7 ? "links" : "rechts",
        is_active: true,
      });

      id++;
    }
  }

  for (let number = 1; number <= 10; number++) {
    seats.push({
      id,
      row_number: 8,
      seat_number: number,
      side: number >= 7 ? "links" : "rechts",
      is_active: true,
    });

    id++;
  }

  for (let number = 1; number <= 12; number++) {
    seats.push({
      id,
      row_number: 9,
      seat_number: number,
      side: "unten",
      is_active: true,
    });

    id++;
  }

  return seats;
}

