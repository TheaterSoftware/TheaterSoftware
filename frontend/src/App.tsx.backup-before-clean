        const assignmentsResponses =
          await Promise.all(
            loadedPerformances.map(
              async (performance) => {
                const response = await fetch(
                  `/api/assignments?performance_id=${performance.id}`
                );

                if (!response.ok) {
                  throw new Error(
                    `Sitzplatz-Zuordnungen konnten nicht geladen werden: HTTP ${response.status}`
