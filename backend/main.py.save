uvicorn main:app --host 127.0.0.1 --port 8000



from datetime import date, time
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import psycopg


app = FastAPI()

app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "http://127.0.0.1:5173",
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:5173",
        "http://127.0.0.1:5174",
        "http://localhost:5174",
        "http://127.0.0.1:5175",
        "http://localhost:5175",
    ],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

DB_CONFIG = "dbname=theater"

VALID_STATUSES = {
    "reserviert",
    "bezahlt",
    "hinterlegt",
    "storniert",
}


class PerformanceCreate(BaseModel):
    title: str
    performance_date: date
    start_time: time


class BookingCreate(BaseModel):
    first_name: str
    last_name: str
    email: str = ""
    phone: str = ""
    ticket_count: int
    ticket_price: float
    service_fee: float = 0.0
    performance_id: int = 1


class SeatAssignmentCreate(BaseModel):
    performance_id: int
    seat_id: int
    booking_id: int


class AssignmentStatusUpdate(BaseModel):
    status: str


@app.get("/")
def root():
    return {"status": "ok"}


# ============================================================
# VORSTELLUNGEN
# ============================================================

@app.get("/api/performances")
def get_performances():
    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT
                    id,
                    title,
                    performance_date,
                    start_time,
                    created_at
                FROM performances
                ORDER BY
                    performance_date ASC,
                    start_time ASC,
                    id ASC
                """
            )

            rows = cur.fetchall()

    return [
        {
            "id": row[0],
            "title": row[1],
            "performance_date": row[2].isoformat(),
            "start_time": row[3].isoformat(),
            "created_at": row[4].isoformat() if row[4] else None,
        }
        for row in rows
    ]


@app.get("/api/performances/{performance_id}")
def get_performance(performance_id: int):
    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT
                    id,
                    title,
                    performance_date,
                    start_time,
                    created_at
                FROM performances
                WHERE id = %s
                """,
                (performance_id,),
            )

            row = cur.fetchone()

    if not row:
        raise HTTPException(
            status_code=404,
            detail="Vorstellung nicht gefunden.",
        )

    return {
        "id": row[0],
        "title": row[1],
        "performance_date": row[2].isoformat(),
        "start_time": row[3].isoformat(),
        "created_at": row[4].isoformat() if row[4] else None,
    }


@app.post("/api/performances")
def create_performance(data: PerformanceCreate):
    if not data.title.strip():
        raise HTTPException(
            status_code=400,
            detail="Titel fehlt.",
        )

    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                INSERT INTO performances (
                    title,
                    performance_date,
                    start_time
                )
                VALUES (%s, %s, %s)
                RETURNING
                    id,
                    title,
                    performance_date,
                    start_time,
                    created_at
                """,
                (
                    data.title.strip(),
                    data.performance_date,
                    data.start_time,
                ),
            )

            row = cur.fetchone()
            conn.commit()

    return {
        "success": True,
        "performance": {
            "id": row[0],
            "title": row[1],
            "performance_date": row[2].isoformat(),
            "start_time": row[3].isoformat(),
            "created_at": row[4].isoformat() if row[4] else None,
        },
    }


@app.delete("/api/performances/{performance_id}")
def delete_performance(performance_id: int):
    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:

            cur.execute(
                """
                SELECT id
                FROM performances
                WHERE id = %s
                """,
                (performance_id,),
            )

            if not cur.fetchone():
                raise HTTPException(
                    status_code=404,
                    detail="Vorstellung nicht gefunden.",
                )

            cur.execute(
                """
                SELECT COUNT(*)
                FROM bookings
                WHERE performance_id = %s
                """,
                (performance_id,),
            )

            booking_count = cur.fetchone()[0]

            if booking_count > 0:
                raise HTTPException(
                    status_code=400,
                    detail=(
                        "Diese Vorstellung kann nicht gelöscht "
                        "werden, weil noch Buchungen vorhanden sind."
                    ),
                )

            cur.execute(
                """
                SELECT COUNT(*)
                FROM seat_assignments
                WHERE performance_id = %s
                """,
                (performance_id,),
            )

            assignment_count = cur.fetchone()[0]

            if assignment_count > 0:
                raise HTTPException(
                    status_code=400,
                    detail=(
                        "Diese Vorstellung kann nicht gelöscht "
                        "werden, weil noch Sitzplatz-Zuweisungen vorhanden sind."
                    ),
                )

            cur.execute(
                """
                DELETE FROM performances
                WHERE id = %s
                """,
                (performance_id,),
            )

            conn.commit()

    return {
        "success": True,
    }


