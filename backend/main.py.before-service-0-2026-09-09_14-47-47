def ensure_paid_stripe_invoice(booking_id: int):
    """Erstellt zur bezahlten Offline-Buchung genau eine Rechnung."""
    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            existing = find_existing_invoice_for_booking(cur, booking_id)
            if existing:
                return existing

            cur.execute(
                """
                SELECT
                    b.performance_id,
                    b.status,
                    checkout_order.items,
                    checkout_order.total_gross
                FROM bookings b
                JOIN public_checkout_orders checkout_order
                  ON checkout_order.booking_id = b.id
                WHERE b.id = %s
                  AND b.stripe_checkout_session_id IS NOT NULL
                  AND checkout_order.status = 'paid'
                LIMIT 1
                """,
                (booking_id,),
            )
            booking = cur.fetchone()
            if not booking:
                raise RuntimeError(
                    "Die bezahlte Stripe-Testbuchung wurde nicht gefunden."
                )
            if str(booking[1] or "").lower() != "bezahlt":
                raise RuntimeError("Die Stripe-Testbuchung ist nicht als bezahlt markiert.")

            performance_id = int(booking[0])
            checkout_items = list(booking[2] or [])
            paid_total = Decimal(str(booking[3] or 0)).quantize(
                Decimal("0.01"),
                ROUND_HALF_UP,
            )
            cur.execute(
                INVOICE_TEMPLATE_SELECT
                + """
                  WHERE is_active = TRUE
                    AND (performance_id = %s OR performance_id IS NULL)
                  ORDER BY
                    CASE WHEN performance_id = %s THEN 0 ELSE 1 END,
                    updated_at DESC,
                    id DESC
                  LIMIT 1
                """,
                (performance_id, performance_id),
            )
            template_row = cur.fetchone()
            if not template_row:
                raise RuntimeError(
                    "Für die Vorstellung ist keine aktive Rechnungsvorlage vorhanden."
                )
            template_id = int(template_row[0])

    invoice_lines = checkout_items_to_invoice_lines(checkout_items)
    if not invoice_lines:
        raise RuntimeError("Die bezahlte Bestellung enthält keine Rechnungspositionen.")

    try:
        invoice = create_invoice_v2(
            InvoiceCreateV2(
                booking_id=booking_id,
                template_id=template_id,
                invoice_date=datetime.now(ZoneInfo("Europe/Berlin")).date(),
                notes="Automatisch nach bestätigter Stripe-Testzahlung erstellt.",
                processor="Stripe-Testzahlung",
                payment_status="bezahlt",
                items=invoice_lines,
            ),
            automatic_invoice_request(paid_total),
        )
        return {
            "invoice_id": int(invoice["invoice_id"]),
            "invoice_number": invoice["invoice_number"],
        }
    except HTTPException as exc:
        # Ein zeitgleich wiederholter Stripe-Webhook kann die Rechnung bereits
        # zwischen Prüfung und INSERT angelegt haben.
        if exc.status_code != 409:
            raise
        with psycopg.connect(DB_CONFIG) as conn:
            with conn.cursor() as cur:
                existing = find_existing_invoice_for_booking(cur, booking_id)
                if existing:
                    return existing
        raise


