                """
                SELECT
                    i.id,
                    i.invoice_number,
                    i.invoice_date,
                    i.gross_amount,
                    i.voucher_amount,
                    i.amount_due,
                    i.payment_status,
                    i.tax_breakdown,
                    i.template_snapshot,
                    b.id,
                    b.booking_number,
                    b.ticket_count,
                    b.delivery_method,
                    c.first_name,
                    c.last_name,
                    c.email,
                    c.street,
                    c.postal_code,
                    c.city,
                    p.title,
                    p.performance_date,
                    p.start_time,
                    p.venue_name,
                    p.id
                FROM invoices i
                JOIN bookings b ON b.id = i.booking_id
                JOIN customers c ON c.id = b.customer_id
                JOIN performances p ON p.id = b.performance_id
