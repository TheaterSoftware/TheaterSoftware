def send_offline_booking_confirmation_email(context):
    """Sendet im Offline-Ausbau immer nur an EMAIL_TEST_RECIPIENT."""
    validate_offline_mail_configuration()
    settings = load_email_template_settings()
    from_address = EMAIL_FROM_ADDRESS or SMTP_USERNAME
    event_date = context["event_date"]
    date_text = (
        f"{event_date.day}.{event_date.month}.{event_date.year}"
        if event_date
        else "—"
    )
    event_time = context["event_time"]
    time_text = event_time.strftime("%H:%M") if event_time else "—"
    customer_name = (
        f"{context['customer_first_name']} {context['customer_last_name']}"
    ).strip()
    delivery_note = (
        settings["delivery_postal_text"]
        if context["delivery_method"] == "postal"
        else settings["delivery_email_text"]
    )

    message = EmailMessage()
    message["Subject"] = render_email_template_text(
        settings["subject_template"],
        context,
    )
    message["From"] = f"{settings['sender_name']} <{from_address}>"
    message["To"] = EMAIL_TEST_RECIPIENT
    message["Date"] = formatdate(localtime=True)
    message["X-TheaterSoftware-Testmail"] = "true"
    message.set_content(
        "\n".join(
            [
                f"Hallo {customer_name},",
                "",
                settings["intro_text"],
                "",
                f"Buchungsnummer: {context['booking_number']}",
                f"Veranstaltung: {context['event_title']}",
                f"Datum: {date_text}",
                f"Uhrzeit: {time_text} Uhr",
                f"Anzahl Tickets: {context['ticket_count']}",
                f"{settings['amount_label']}: {euro_text(context['amount_due'])}",
                "",
                delivery_note,
                "Dies ist eine Offline-Testmail. Die ursprünglich in der Buchung "
                f"hinterlegte Adresse lautet: {context['customer_email']}",
                "",
                settings["thank_you_text"],
                "",
                settings["closing_text"],
                settings["sender_name"],
            ]
        )
    )
    message.add_alternative(
        booking_confirmation_html(context, settings),
        subtype="html",
    )
    tls_context = ssl.create_default_context()
    if SMTP_SECURITY == "ssl":
        smtp = smtplib.SMTP_SSL(
            SMTP_HOST,
            SMTP_PORT,
            timeout=20,
            context=tls_context,
        )
    else:
        smtp = smtplib.SMTP(SMTP_HOST, SMTP_PORT, timeout=20)
    with smtp:
        smtp.ehlo()
        if SMTP_SECURITY == "starttls":
            smtp.starttls(context=tls_context)
            smtp.ehlo()
        if SMTP_USERNAME:
            smtp.login(SMTP_USERNAME, SMTP_PASSWORD)
        smtp.send_message(message)


