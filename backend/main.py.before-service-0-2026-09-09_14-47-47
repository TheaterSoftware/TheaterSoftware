def load_ticket_context(context):
    """Ergänzt den Buchungskontext um stabile Ticket-QR-Codes und Plätze."""
    booking_id = int(context["booking_id"])
    ticket_count = int(context.get("ticket_count") or 0)
    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT
                    sa.seat_id,
                    s.row_number,
                    s.seat_number,
                    s.side,
                    s.hall_type,
                    s.table_number,
                    s.table_seat_number
                FROM seat_assignments sa
                JOIN seats s ON s.id = sa.seat_id
                WHERE sa.booking_id = %s
                ORDER BY
                    COALESCE(s.table_number, s.row_number),
                    COALESCE(s.table_seat_number, s.seat_number),
                    sa.id
                """,
                (booking_id,),
            )
            seats = [
                {
                    "seat_id": int(row[0]),
                    "row_number": row[1],
                    "seat_number": row[2],
                    "side": row[3] or "",
                    "hall_type": row[4] or "",
                    "table_number": row[5],
                    "table_seat_number": row[6],
                }
                for row in cur.fetchall()
            ]

            tickets = []
            for index in range(1, ticket_count + 1):
                seat = seats[index - 1] if index <= len(seats) else None
                seat_id = seat["seat_id"] if seat else None
                cur.execute(
                    """
                    SELECT token
                    FROM ticket_passes
                    WHERE booking_id = %s AND ticket_index = %s
                    FOR UPDATE
                    """,
                    (booking_id, index),
                )
                row = cur.fetchone()
                if row:
                    token = row[0]
                    cur.execute(
                        """
                        UPDATE ticket_passes
                        SET seat_id = %s, updated_at = CURRENT_TIMESTAMP
                        WHERE booking_id = %s AND ticket_index = %s
                        """,
                        (seat_id, booking_id, index),
                    )
                else:
                    token = uuid4().hex
                    cur.execute(
                        """
                        INSERT INTO ticket_passes (
                            booking_id, ticket_index, seat_id, token
                        )
                        VALUES (%s, %s, %s, %s)
                        """,
                        (booking_id, index, seat_id, token),
                    )
                tickets.append(
                    {
                        "index": index,
                        "token": token,
                        "seat": seat,
                        "seat_label": ticket_seat_label(seat),
                    }
                )
        conn.commit()
    enriched = dict(context)
    enriched["tickets"] = tickets
    return enriched


