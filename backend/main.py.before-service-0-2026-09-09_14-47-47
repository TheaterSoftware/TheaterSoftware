@app.post("/api/admin/ticket-event-templates/{performance_id}/background")
async def upload_ticket_event_background(
    performance_id: int,
    request: Request,
    background: UploadFile = File(...),
):
    require_admin(request)
    actor_id, actor_name = get_actor(request)
    # Prüft zugleich, ob die Vorstellung existiert.
    current = performance_ticket_template_summary(performance_id)
    content = await background.read(MAX_TICKET_TEMPLATE_BYTES + 1)
    await background.close()
    if not content:
        raise HTTPException(status_code=400, detail="Die Ticketvorlage ist leer.")
    if len(content) > MAX_TICKET_TEMPLATE_BYTES:
        raise HTTPException(status_code=413, detail="Die Ticketvorlage darf höchstens 25 MB groß sein.")
    detected = detect_ticket_template_format(content)
    if not detected:
        raise HTTPException(status_code=400, detail="Bitte eine PDF-, JPG- oder PNG-Ticketvorlage auswählen.")
    extension, mime_type = detected
    filename = f"{performance_id}-{uuid4().hex}.{extension}"
    TICKET_TEMPLATE_DIR.mkdir(parents=True, exist_ok=True)
    new_path = TICKET_TEMPLATE_DIR / filename
    new_path.write_bytes(content)

    # PDF-Größe vorab prüfen. Das Printabl-Endformat ist 85 x 210 mm.
    if mime_type == "application/pdf":
        try:
            vendor_dir = Path(__file__).resolve().parent / "_vendor"
            if str(vendor_dir) not in sys.path:
                sys.path.insert(0, str(vendor_dir))
            from pypdf import PdfReader
            reader = PdfReader(str(new_path))
            if not reader.pages:
                raise ValueError("PDF ohne Seite")
            page = reader.pages[0]
            width_mm = float(page.mediabox.width) * 25.4 / 72.0
            height_mm = float(page.mediabox.height) * 25.4 / 72.0
            if abs(width_mm - 85.0) > 2.0 or abs(height_mm - 210.0) > 2.0:
                raise HTTPException(
                    status_code=400,
                    detail=(
                        f"Die PDF-Vorlage hat etwa {width_mm:.1f} x {height_mm:.1f} mm. "
                        "Erwartet werden 85 x 210 mm Hochformat."
                    ),
                )
        except HTTPException:
            new_path.unlink(missing_ok=True)
            raise
        except Exception as exc:
            new_path.unlink(missing_ok=True)
            raise HTTPException(status_code=400, detail=f"Die PDF-Ticketvorlage konnte nicht gelesen werden: {exc}") from exc

    old_path = ticket_template_path(current["background_filename"])
    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                INSERT INTO ticket_event_templates (
                    performance_id, email_settings, layout_settings,
                    background_filename, background_original_name,
                    background_mime_type, updated_at, updated_by
                )
                VALUES (%s, %s, %s, %s, %s, %s, NOW(), %s)
                ON CONFLICT (performance_id) DO UPDATE
                SET background_filename = EXCLUDED.background_filename,
                    background_original_name = EXCLUDED.background_original_name,
                    background_mime_type = EXCLUDED.background_mime_type,
                    updated_at = NOW(),
                    updated_by = EXCLUDED.updated_by
                """,
                (
                    performance_id,
                    Jsonb(current["email_settings"]),
                    Jsonb(current["layout_settings"]),
                    filename,
                    str(background.filename or f"Ticketvorlage.{extension}")[:255],
                    mime_type,
                    str(actor_id or actor_name or ""),
                ),
            )
            write_activity(
                cur,
                request,
                action="Ticketgrafik hochgeladen",
                entity_type="ticket_event_template",
                entity_id=performance_id,
                performance_id=performance_id,
                description=f"Ticketgrafik für {current['event_title']} hochgeladen",
            )
        conn.commit()
    if old_path and old_path != new_path:
        old_path.unlink(missing_ok=True)
    return {"success": True, "template": get_ticket_event_template(performance_id, request)}


