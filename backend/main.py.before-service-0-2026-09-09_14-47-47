def ticket_seat_label(seat):
    if not seat:
        return "Freie Platzwahl / Platzzuweisung vor Ort"
    if seat.get("hall_type") == "tischsaal" and seat.get("table_number"):
        number = seat.get("table_seat_number") or seat.get("seat_number")
        return f"Tisch {seat['table_number']} - Platz {number}"
    row = seat.get("row_number")
    number = seat.get("seat_number")
    if row is not None and number is not None:
        return f"Reihe {row} - Platz {number}"
    return "Platzzuweisung vor Ort"


