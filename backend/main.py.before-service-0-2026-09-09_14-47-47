MESSAGE_TYPE_BOOKING_CONFIRMATION = "stripe_paid_confirmation"
MESSAGE_TYPE_TICKETS = "stripe_paid_tickets"
MESSAGE_TYPE_INVOICE = "stripe_paid_invoice"


def reserve_message_delivery(context, message_type):
    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                INSERT INTO invoice_email_deliveries (
                    booking_id, invoice_id, message_type,
                    original_recipient, actual_recipient, status
                )
                VALUES (%s, %s, %s, %s, %s, 'pending')
                ON CONFLICT (booking_id, message_type) DO NOTHING
                """,
                (context["booking_id"], context.get("invoice_id"), message_type, context.get("customer_email", ""), EMAIL_TEST_RECIPIENT),
            )
            cur.execute(
                """
                SELECT id, status, updated_at
                FROM invoice_email_deliveries
                WHERE booking_id = %s AND message_type = %s
                FOR UPDATE
                """,
                (context["booking_id"], message_type),
            )
            row = cur.fetchone()
            if not row:
                raise RuntimeError("Der lokale E-Mail-Ausgang konnte nicht angelegt werden.")
            delivery_id, status, updated_at = row
            if status == "sent":
                return {"delivery_id": int(delivery_id), "send": False, "status": "sent"}
            if status == "sending" and updated_at and updated_at > datetime.now() - timedelta(minutes=5):
                return {"delivery_id": int(delivery_id), "send": False, "status": "sending"}
            cur.execute(
                """
                UPDATE invoice_email_deliveries
                SET invoice_id = %s, original_recipient = %s,
                    actual_recipient = %s, status = 'sending',
                    attempt_count = attempt_count + 1, last_error = '',
                    updated_at = CURRENT_TIMESTAMP
                WHERE id = %s
                """,
                (context.get("invoice_id"), context.get("customer_email", ""), EMAIL_TEST_RECIPIENT, delivery_id),
            )
        conn.commit()
    return {"delivery_id": int(delivery_id), "send": True, "status": "sending"}


def mark_message_delivery_sent(delivery_id: int):
    mark_invoice_email_sent(delivery_id)


def record_message_delivery_failure(context, message_type, error):
    error_text = str(error or "Unbekannter Versandfehler")[:1000]
    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                INSERT INTO invoice_email_deliveries (
                    booking_id, invoice_id, message_type,
                    original_recipient, actual_recipient, status, last_error
                )
                VALUES (%s, %s, %s, %s, %s, 'failed', %s)
                ON CONFLICT (booking_id, message_type) DO UPDATE
                SET invoice_id = EXCLUDED.invoice_id,
                    original_recipient = EXCLUDED.original_recipient,
                    actual_recipient = EXCLUDED.actual_recipient,
                    status = CASE WHEN invoice_email_deliveries.status = 'sent' THEN 'sent' ELSE 'failed' END,
                    last_error = CASE WHEN invoice_email_deliveries.status = 'sent' THEN invoice_email_deliveries.last_error ELSE EXCLUDED.last_error END,
                    updated_at = CURRENT_TIMESTAMP
                """,
                (context["booking_id"], context.get("invoice_id"), message_type, context.get("customer_email", ""), EMAIL_TEST_RECIPIENT, error_text),
            )
        conn.commit()


def reserve_invoice_email_delivery(context):
    """Reserviert genau einen Versandversuch je Buchung."""
    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                INSERT INTO invoice_email_deliveries (
                    booking_id,
                    invoice_id,
                    message_type,
                    original_recipient,
                    actual_recipient,
                    status
                )
                VALUES (%s, %s, %s, %s, %s, 'pending')
                ON CONFLICT (booking_id, message_type) DO NOTHING
                """,
                (
                    context["booking_id"],
                    context["invoice_id"],
                    AUTOMATIC_INVOICE_MESSAGE_TYPE,
                    context["customer_email"],
                    EMAIL_TEST_RECIPIENT,
                ),
            )
            cur.execute(
                """
                SELECT id, status, updated_at
                FROM invoice_email_deliveries
                WHERE booking_id = %s AND message_type = %s
                FOR UPDATE
                """,
                (context["booking_id"], AUTOMATIC_INVOICE_MESSAGE_TYPE),
            )
            delivery = cur.fetchone()
            if not delivery:
                raise RuntimeError("Der lokale E-Mail-Ausgang konnte nicht angelegt werden.")
            delivery_id, status, updated_at = delivery
            if status == "sent":
                return {"delivery_id": int(delivery_id), "send": False, "status": "sent"}
            if (
                status == "sending"
                and updated_at
                and updated_at > datetime.now() - timedelta(minutes=5)
            ):
                return {"delivery_id": int(delivery_id), "send": False, "status": "sending"}
            cur.execute(
                """
                UPDATE invoice_email_deliveries
                SET
                    invoice_id = %s,
                    original_recipient = %s,
                    actual_recipient = %s,
                    status = 'sending',
                    attempt_count = attempt_count + 1,
                    last_error = '',
                    updated_at = CURRENT_TIMESTAMP
                WHERE id = %s
                """,
                (
                    context["invoice_id"],
                    context["customer_email"],
                    EMAIL_TEST_RECIPIENT,
                    delivery_id,
                ),
            )
        conn.commit()
    return {"delivery_id": int(delivery_id), "send": True, "status": "sending"}


def mark_invoice_email_sent(delivery_id: int):
    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                UPDATE invoice_email_deliveries
                SET status = 'sent', sent_at = CURRENT_TIMESTAMP,
                    last_error = '', updated_at = CURRENT_TIMESTAMP
                WHERE id = %s
                """,
                (delivery_id,),
            )
        conn.commit()


def record_invoice_email_failure(booking_id: int, error):
    error_text = str(error or "Unbekannter Versandfehler")[:1000]
    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            cur.execute(
                "SELECT id FROM invoices WHERE booking_id = %s ORDER BY id DESC LIMIT 1",
                (booking_id,),
            )
            invoice = cur.fetchone()
            cur.execute(
                """
                SELECT c.email
                FROM bookings b
                JOIN customers c ON c.id = b.customer_id
                WHERE b.id = %s
                LIMIT 1
                """,
                (booking_id,),
            )
            customer = cur.fetchone()
            cur.execute(
                """
                INSERT INTO invoice_email_deliveries (
                    booking_id,
                    invoice_id,
                    message_type,
                    original_recipient,
                    actual_recipient,
                    status,
                    last_error
                )
                VALUES (%s, %s, %s, %s, %s, 'failed', %s)
                ON CONFLICT (booking_id, message_type) DO UPDATE
                SET
                    invoice_id = COALESCE(
                        EXCLUDED.invoice_id,
                        invoice_email_deliveries.invoice_id
                    ),
                    original_recipient = EXCLUDED.original_recipient,
                    actual_recipient = EXCLUDED.actual_recipient,
                    status = CASE
                        WHEN invoice_email_deliveries.status = 'sent' THEN 'sent'
                        ELSE 'failed'
                    END,
                    last_error = CASE
                        WHEN invoice_email_deliveries.status = 'sent'
                            THEN invoice_email_deliveries.last_error
                        ELSE EXCLUDED.last_error
                    END,
                    updated_at = CURRENT_TIMESTAMP
                """,
                (
                    booking_id,
                    int(invoice[0]) if invoice else None,
                    AUTOMATIC_INVOICE_MESSAGE_TYPE,
                    customer[0] if customer else "",
                    EMAIL_TEST_RECIPIENT,
                    error_text,
                ),
            )
        conn.commit()


def prepare_and_send_paid_booking_confirmation(booking_id: int):
    """Versendet Bestätigung, Tickets und Rechnung als drei getrennte Offline-Mails."""
    invoice = ensure_paid_stripe_invoice(booking_id)
    base_context = load_invoice_email_context(invoice["invoice_id"])
    ticket_context = load_ticket_context(base_context)
    results = {}
    errors = []
    jobs = [
        ("booking_confirmation", MESSAGE_TYPE_BOOKING_CONFIRMATION, lambda: send_offline_booking_confirmation_email(base_context)),
    ]
    if base_context.get("delivery_method") != "postal":
        jobs.append(("tickets", MESSAGE_TYPE_TICKETS, lambda: send_offline_ticket_email(ticket_context, ticket_pdf_bytes(ticket_context))))
    else:
        results["tickets"] = "postal_delivery"
    jobs.append(("invoice", MESSAGE_TYPE_INVOICE, lambda: send_offline_invoice_email(base_context, invoice_pdf_bytes(base_context))))
    for key, message_type, send_job in jobs:
        delivery = reserve_message_delivery(base_context, message_type)
        if not delivery["send"]:
            results[key] = delivery["status"]
            continue
        try:
            send_job()
            mark_message_delivery_sent(delivery["delivery_id"])
            results[key] = "sent"
        except Exception as exc:
            record_message_delivery_failure(base_context, message_type, exc)
            results[key] = "failed"
            errors.append(f"{key}: {exc}")
    if errors:
        raise RuntimeError(" | ".join(errors))
    return {
        "success": True,
        "status": "sent",
        "booking_id": booking_id,
        "invoice_number": base_context["invoice_number"],
        "test_recipient": EMAIL_TEST_RECIPIENT,
        "messages": results,
    }


@app.post("/api/invoice-emails/{booking_id}/retry")
def retry_paid_booking_confirmation(booking_id: int, request: Request):
    """Erlaubt Mitarbeitern einen fehlgeschlagenen Offline-Test erneut zu senden."""
    require_staff(request)
    try:
        return prepare_and_send_paid_booking_confirmation(booking_id)
    except Exception as exc:
        raise HTTPException(status_code=502, detail=str(exc)[:500]) from exc


@app.post("/api/ticket-emails/{booking_id}/retry")
def retry_ticket_email(booking_id: int, request: Request):
    require_staff(request)
    invoice = ensure_paid_stripe_invoice(booking_id)
    base_context = load_invoice_email_context(invoice["invoice_id"])
    if base_context.get("delivery_method") == "postal":
        raise HTTPException(status_code=400, detail="Für diese Buchung ist Postversand ausgewählt; es wird keine digitale Ticket-Mail versendet.")
    ticket_context = load_ticket_context(base_context)
    delivery = reserve_message_delivery(base_context, MESSAGE_TYPE_TICKETS)
    if not delivery["send"]:
        return {"success": delivery["status"] == "sent", "status": delivery["status"]}
    try:
        send_offline_ticket_email(ticket_context, ticket_pdf_bytes(ticket_context))
        mark_message_delivery_sent(delivery["delivery_id"])
        return {"success": True, "status": "sent", "booking_id": booking_id}
    except Exception as exc:
        record_message_delivery_failure(base_context, MESSAGE_TYPE_TICKETS, exc)
        raise HTTPException(status_code=502, detail=str(exc)[:500]) from exc


@app.get("/api/invoice-emails")
def get_invoice_email_deliveries(request: Request):
    require_staff(request)
    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT
                    delivery.id,
                    delivery.booking_id,
                    booking.booking_number,
                    invoice.invoice_number,
                    delivery.message_type,
                    delivery.status,
                    delivery.attempt_count,
                    delivery.original_recipient,
                    delivery.actual_recipient,
                    delivery.last_error,
                    delivery.sent_at,
                    delivery.updated_at
                FROM invoice_email_deliveries delivery
                JOIN bookings booking ON booking.id = delivery.booking_id
                LEFT JOIN invoices invoice ON invoice.id = delivery.invoice_id
                ORDER BY delivery.id DESC
                LIMIT 100
                """
            )
            rows = cur.fetchall()
    return [
        {
            "id": int(row[0]),
            "booking_id": int(row[1]),
            "booking_number": row[2],
            "invoice_number": row[3],
            "message_type": row[4],
            "status": row[5],
            "attempt_count": int(row[6]),
            "original_recipient": row[7],
            "actual_recipient": row[8],
            "last_error": row[9],
            "sent_at": row[10].isoformat() if row[10] else None,
            "updated_at": row[11].isoformat() if row[11] else None,
        }
        for row in rows
    ]
