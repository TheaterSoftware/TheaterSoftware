def validate_offline_mail_configuration():
    missing = []
    if not EMAIL_TEST_RECIPIENT:
        missing.append("EMAIL_TEST_RECIPIENT")
    if not SMTP_HOST:
        missing.append("SMTP_HOST")
    if not (EMAIL_FROM_ADDRESS or SMTP_USERNAME):
        missing.append("EMAIL_FROM_ADDRESS oder SMTP_USERNAME")
    if missing:
        raise RuntimeError(
            "Offline-Mailversand ist noch nicht vollständig eingerichtet: "
            + ", ".join(missing)
        )
    if not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", EMAIL_TEST_RECIPIENT):
        raise RuntimeError("EMAIL_TEST_RECIPIENT ist keine gültige E-Mail-Adresse.")
    if SMTP_SECURITY not in {"starttls", "ssl", "none"}:
        raise RuntimeError("SMTP_SECURITY muss starttls, ssl oder none sein.")


