SERVICE_FEE_PERCENT = Decimal("3.00")
SERVICE_VAT_RATE = 19


def calculate_service_gross(base_gross):
    base = Decimal(str(base_gross or 0)).quantize(
        Decimal("0.01"),
        rounding=ROUND_HALF_UP,
    )
    return (
        base * SERVICE_FEE_PERCENT / Decimal("100")
    ).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)


def calculate_price_component(net_value, vat_rate: int):
    net = Decimal(str(net_value or 0)).quantize(
        Decimal("0.01"),
        rounding=ROUND_HALF_UP,
    )
    vat = (net * Decimal(vat_rate) / Decimal(100)).quantize(
        Decimal("0.01"),
        rounding=ROUND_HALF_UP,
    )
    return {
        "net": float(net),
        "vat_rate": vat_rate,
        "vat": float(vat),
        "gross": float(net + vat),
    }


def calculate_price_breakdown(
    ticket_price_net,
    ticket_vat_rate: int,
    service_fee_net,
    additional_fee_name: str,
    additional_fee_net,
    additional_fee_vat_rate: int,
):
    ticket = calculate_price_component(ticket_price_net, ticket_vat_rate)
    additional = calculate_price_component(
        additional_fee_net,
        additional_fee_vat_rate,
    )
    service_gross = calculate_service_gross(
        Decimal(str(ticket["gross"])) + Decimal(str(additional["gross"]))
    )
    service = calculate_gross_price_component(
        {
            "category": "service",
            "name": "Servicepauschale",
            "gross_amount": service_gross,
            "vat_rate": SERVICE_VAT_RATE,
            "provider_type": "external",
            "provider_name": "",
        }
    )

    total_net = Decimal(str(ticket["net"])) + Decimal(str(service["net"])) + Decimal(str(additional["net"]))
    total_vat = Decimal(str(ticket["vat"])) + Decimal(str(service["vat"])) + Decimal(str(additional["vat"]))
    total_gross = total_net + total_vat

    return {
        "ticket": ticket,
        "service": service,
        "additional": {
            "name": additional_fee_name.strip(),
            **additional,
        },
        "total_net": float(total_net),
        "total_vat": float(total_vat),
        "total_gross": float(total_gross),
    }


def calculate_gross_price_component(item):
    gross = Decimal(str(item.get("gross_amount", 0) or 0)).quantize(
        Decimal("0.01"),
        rounding=ROUND_HALF_UP,
    )
    vat_rate = int(item.get("vat_rate", 0) or 0)
    divisor = Decimal("1") + Decimal(vat_rate) / Decimal("100")
    net = (gross / divisor).quantize(
        Decimal("0.01"),
        rounding=ROUND_HALF_UP,
    )
    vat = gross - net

    return {
        "category": item.get("category", "other"),
        "name": str(item.get("name", "")).strip(),
        "provider_type": item.get("provider_type", "internal"),
        "provider_name": str(item.get("provider_name", "")).strip(),
        "gross": float(gross),
        "net": float(net),
        "vat_rate": vat_rate,
        "vat": float(vat),
    }


def calculate_structured_price_breakdown(price_items):
    items = [calculate_gross_price_component(item) for item in price_items]
    items.sort(
        key=lambda item: Decimal(str(item["gross"])),
        reverse=True,
    )
    subtotal_gross = sum(
        (Decimal(str(item["gross"])) for item in items),
        Decimal("0"),
    )
    service_gross = calculate_service_gross(subtotal_gross)
    service = calculate_gross_price_component(
        {
            "category": "service",
            "name": "Servicepauschale",
            "gross_amount": service_gross,
            "vat_rate": SERVICE_VAT_RATE,
            "provider_type": "external",
            "provider_name": "",
        }
    )

    total_net = sum(
        (Decimal(str(item["net"])) for item in items),
        Decimal("0"),
    ) + Decimal(str(service["net"]))
    total_vat = sum(
        (Decimal(str(item["vat"])) for item in items),
        Decimal("0"),
    ) + Decimal(str(service["vat"]))
    total_gross = subtotal_gross + service_gross

    return {
        "items": items,
        "service": service,
        "service_fee_percent": float(SERVICE_FEE_PERCENT),
        "subtotal_gross": float(subtotal_gross),
        "total_net": float(total_net),
        "total_vat": float(total_vat),
        "total_gross": float(total_gross),
    }


PERFORMANCE_INCLUDED_TICKET_MIGRATION = "performance_included_ticket_components_v1"


def migrate_included_ticket_components():
    """
    Einmalige Offline-Migration vom alten Preisverständnis auf die neue Logik:
    Der bisherige Ticketwert war der komplette Ticketpreis und Essen/Getränke
    wurden zusätzlich gespeichert. Künftig ist der Ticket-Eintrag in price_items
    nur noch der Eintrittsanteil; Ticket + Essen + Getränke ergeben den
    unveränderten Ticket-Gesamtpreis.
    """
    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT 1
                FROM invoice_module_migrations
                WHERE migration_key = %s
                LIMIT 1
                """,
                (PERFORMANCE_INCLUDED_TICKET_MIGRATION,),
            )
            if cur.fetchone():
                return

            cur.execute(
                """
                SELECT id, ticket_price_net, ticket_vat_rate, price_items
                FROM performances
                ORDER BY id
                """
            )
            for performance_id, legacy_ticket_net, ticket_vat_rate, stored_items in cur.fetchall():
                if not isinstance(stored_items, list) or not stored_items:
                    continue

                items = [dict(item) for item in stored_items if isinstance(item, dict)]
                ticket_index = next(
                    (index for index, item in enumerate(items) if item.get("category") == "ticket"),
                    None,
                )
                if ticket_index is None:
                    continue

                included_gross = sum(
                    (
                        Decimal(str(item.get("gross_amount", 0) or 0))
                        for item in items
                        if item.get("category") in {"food", "drink"}
                    ),
                    Decimal("0"),
                ).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
                if included_gross <= 0:
                    continue

                rate = Decimal(str(ticket_vat_rate or 0))
                legacy_total = (
                    Decimal(str(legacy_ticket_net or 0))
                    * (Decimal("1") + rate / Decimal("100"))
                ).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
                current_ticket_gross = Decimal(
                    str(items[ticket_index].get("gross_amount", 0) or 0)
                ).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)

                # Nur eindeutig alte Datensätze anfassen. So bleibt die Migration
                # auch bei ungewöhnlichen Altbeständen konservativ.
                if abs(current_ticket_gross - legacy_total) > Decimal("0.02"):
                    continue
                if included_gross > legacy_total:
                    continue

                admission_gross = (legacy_total - included_gross).quantize(
                    Decimal("0.01"),
                    rounding=ROUND_HALF_UP,
                )
                items[ticket_index]["gross_amount"] = float(admission_gross)
                divisor = Decimal("1") + rate / Decimal("100")
                admission_net = (admission_gross / divisor).quantize(
                    Decimal("0.01"),
                    rounding=ROUND_HALF_UP,
                )
                breakdown = calculate_structured_price_breakdown(items)
                cur.execute(
                    """
                    UPDATE performances
                    SET
                        ticket_price_net = %s,
                        service_fee_net = %s,
                        price_items = %s,
                        price_from = %s
                    WHERE id = %s
                    """,
                    (
                        admission_net,
                        Decimal(str(breakdown["service"]["net"])).quantize(Decimal("0.01")),
                        Jsonb(items),
                        Decimal(str(breakdown["total_gross"])).quantize(Decimal("0.01")),
                        performance_id,
                    ),
                )

            cur.execute(
                """
                INSERT INTO invoice_module_migrations (migration_key)
                VALUES (%s)
                """,
                (PERFORMANCE_INCLUDED_TICKET_MIGRATION,),
            )
            conn.commit()


def make_public_slug(title: str, performance_id: int) -> str:
    normalized = unicodedata.normalize("NFKD", title)
    ascii_title = normalized.encode("ascii", "ignore").decode("ascii")
    base = re.sub(r"[^a-z0-9]+", "-", ascii_title.lower()).strip("-")
    return f"{base or 'event'}-{performance_id}"


def performance_to_dict(row):
    price_items = row[26] if isinstance(row[26], list) else []

    if price_items:
        price_breakdown = calculate_structured_price_breakdown(price_items)
    else:
        price_breakdown = calculate_price_breakdown(
            row[19],
            int(row[20] or 0),
            row[21],
            row[23] or "",
            row[24],
            int(row[25] or 0),
        )

    return {
        "id": row[0],
        "title": row[1],
        "performance_date": row[2].isoformat(),
        "start_time": row[3].isoformat(),
        "created_at": row[4].isoformat() if row[4] else None,
        "hall_plan_type": row[5] or "hall_1",
        "short_description": row[6] or "",
        "description": row[7] or "",
        "image_url": row[8] or "",
        "venue_name": row[9] or "",
        "doors_time": row[10].isoformat() if row[10] else None,
        "sales_start_at": row[11].isoformat() if row[11] else None,
        "sales_end_at": row[12].isoformat() if row[12] else None,
        "publication_status": row[13] or "draft",
        "seating_mode": row[14] or "assigned",
        "capacity": row[15],
        "price_from": float(price_breakdown["total_gross"]),
        "max_tickets_per_order": int(row[17] or 10),
        "public_slug": row[18] or "",
        "ticket_price_net": float(row[19] or 0),
        "ticket_vat_rate": int(row[20] or 0),
        "service_fee_net": float(row[21] or 0),
        "service_vat_rate": SERVICE_VAT_RATE,
