def ticket_pdf_bytes(context, settings=None):
    """Erstellt pro Eintrittskarte ein 85 x 210 mm Ticket und legt den QR dynamisch über die Eventvorlage."""
    try:
        from reportlab.graphics import renderPDF
        from reportlab.graphics.barcode.qr import QrCodeWidget
        from reportlab.graphics.shapes import Drawing
        from reportlab.lib import colors
        from reportlab.lib.units import mm
        from reportlab.pdfbase import pdfmetrics
        from reportlab.pdfgen import canvas
        from reportlab.lib.utils import ImageReader
    except ImportError as exc:
        raise RuntimeError("Die PDF-Abhängigkeit reportlab ist noch nicht installiert.") from exc

    event_template = load_ticket_event_template(context.get("performance_id"))
    effective_settings = settings if settings is not None else event_template["email_settings"]
    settings = normalize_ticket_email_template_settings(effective_settings)
    layout = normalize_ticket_layout_settings(event_template.get("layout_settings"))
    background_path = event_template.get("background_path")
    background_mime_type = event_template.get("background_mime_type") or ""

    tickets = list(context.get("tickets") or [])
    if not tickets:
        raise RuntimeError("Für die Buchung konnten keine Tickets erzeugt werden.")

    page_width = 85 * mm
    page_height = 210 * mm
    safe_left = 6 * mm
    safe_right = page_width - 6 * mm
    content_width = safe_right - safe_left
    perforation_y = 28 * mm

    accent = colors.HexColor(settings.get("accent_color") or "#CC0167")
    text_color = colors.HexColor(settings.get("text_color") or "#231f20")
    muted = colors.HexColor("#666066")
    border = colors.HexColor("#ded8dc")

    event_date = context.get("event_date")
    event_time = context.get("event_time")
    date_text = f"{event_date.day:02d}.{event_date.month:02d}.{event_date.year}" if event_date else "—"
    time_text = event_time.strftime("%H:%M") if event_time else "—"
    venue = str(context.get("venue_text") or "—").replace("\n", ", ")
    booking_number = str(context.get("booking_number") or "")
    event_title = str(context.get("event_title") or "Veranstaltung")

    buffer = BytesIO()
    pdf = canvas.Canvas(buffer, pagesize=(page_width, page_height))
    pdf.setTitle(f"Tickets {booking_number}")
    pdf.setAuthor(settings["sender_name"])

    def fit_text(text, font_name, max_size, min_size, max_width):
        value = str(text or "")
        size = float(max_size)
        while size > min_size and pdfmetrics.stringWidth(value, font_name, size) > max_width:
            size -= 0.5
        return max(size, min_size)

    def draw_wrapped(text, x, y, max_width, *, font="Helvetica", size=8.5, leading=11, max_lines=3, color=text_color):
        words = str(text or "").split()
        lines = []
        current = ""
        for word in words:
            trial = word if not current else current + " " + word
            if pdfmetrics.stringWidth(trial, font, size) <= max_width:
                current = trial
            else:
                if current:
                    lines.append(current)
                current = word
                if len(lines) >= max_lines:
                    break
        if current and len(lines) < max_lines:
            lines.append(current)
        pdf.setFillColor(color)
        pdf.setFont(font, size)
        yy = y
        for line in lines:
            pdf.drawString(x, yy, line)
            yy -= leading
        return yy

    def draw_qr(value, x, y, size):
        qr = QrCodeWidget(value)
        x1, y1, x2, y2 = qr.getBounds()
        drawing = Drawing(
            size,
            size,
            transform=[size / (x2 - x1), 0, 0, size / (y2 - y1), 0, 0],
        )
        drawing.add(qr)
        renderPDF.draw(drawing, pdf, x, y)

    image_background = None
    if background_path and background_mime_type in {"image/png", "image/jpeg"}:
        image_background = ImageReader(str(background_path))

    for position, ticket in enumerate(tickets):
        token = str(ticket.get("token") or "")
        if not re.fullmatch(r"[a-f0-9]{32}", token):
            raise RuntimeError("Für ein Ticket wurde kein gültiger QR-Token gefunden.")

        if not (background_path and background_mime_type == "application/pdf"):
            pdf.setFillColor(colors.white)
            pdf.rect(0, 0, page_width, page_height, fill=1, stroke=0)

        if image_background is not None:
            pdf.drawImage(
                image_background,
                0,
                0,
                width=page_width,
                height=page_height,
                preserveAspectRatio=False,
                mask="auto",
            )
        elif not background_path:
            # Standardlayout bleibt als Fallback, solange noch keine Eventgrafik hochgeladen wurde.
            pdf.setFillColor(accent)
            pdf.rect(0, page_height - 19 * mm, page_width, 19 * mm, fill=1, stroke=0)
            pdf.setFillColor(colors.white)
            pdf.setFont("Helvetica-Bold", 11)
            pdf.drawString(safe_left, page_height - 11.5 * mm, str(settings.get("sender_name") or "Boulevardtheater Deidesheim"))
            pdf.setFont("Helvetica-Bold", 6.5)
            pdf.drawRightString(safe_right, page_height - 11.2 * mm, "EINTRITTSKARTE")

            title_size = fit_text(event_title, "Helvetica-Bold", 15, 9, content_width)
            pdf.setFillColor(text_color)
            pdf.setFont("Helvetica-Bold", title_size)
            pdf.drawString(safe_left, page_height - 31 * mm, event_title)
            pdf.setStrokeColor(border)
            pdf.line(safe_left, page_height - 36 * mm, safe_right, page_height - 36 * mm)
            pdf.setFillColor(muted)
            pdf.setFont("Helvetica-Bold", 6.5)
            pdf.drawString(safe_left, page_height - 44 * mm, "DATUM")
            pdf.drawString(35 * mm, page_height - 44 * mm, "UHRZEIT")
            pdf.setFillColor(text_color)
            pdf.setFont("Helvetica-Bold", 10)
            pdf.drawString(safe_left, page_height - 50 * mm, date_text)
            pdf.drawString(35 * mm, page_height - 50 * mm, f"{time_text} Uhr")
            pdf.setFillColor(muted)
            pdf.setFont("Helvetica-Bold", 6.5)
            pdf.drawString(safe_left, page_height - 59 * mm, "VERANSTALTUNGSORT")
            draw_wrapped(venue, safe_left, page_height - 65 * mm, content_width, font="Helvetica-Bold", size=8.5, leading=10, max_lines=2)

        # Der QR-Code ist immer dynamisch. Er wird nie aus der hochgeladenen Grafik übernommen.
        qr_size = layout["qr_size_mm"] * mm
        qr_x = layout["qr_x_mm"] * mm
        qr_y = layout["qr_y_mm"] * mm
        if qr_x + qr_size > page_width:
            qr_x = page_width - qr_size
        if qr_y + qr_size > page_height:
            qr_y = page_height - qr_size
        pdf.setFillColor(colors.white)
        pdf.setStrokeColor(border)
        pdf.roundRect(qr_x - 1.8 * mm, qr_y - 1.8 * mm, qr_size + 3.6 * mm, qr_size + 3.6 * mm, 1.5 * mm, fill=1, stroke=1)
        draw_qr(f"BTD|{token}", qr_x, qr_y, qr_size)

        if layout.get("show_ticket_data", True):
            box_y = max(31 * mm, qr_y - 31 * mm)
            box_h = 22 * mm
            pdf.setFillColor(colors.Color(1, 1, 1, alpha=0.93))
            pdf.roundRect(safe_left, box_y, content_width, box_h, 2 * mm, fill=1, stroke=0)
            seat_label = str(ticket.get("seat_label") or "Platzzuweisung vor Ort")
            pdf.setFillColor(muted)
            pdf.setFont("Helvetica", 7)
            pdf.drawString(safe_left + 3 * mm, box_y + 15 * mm, "Buchung")
            pdf.drawString(safe_left + 3 * mm, box_y + 9 * mm, "Platz")
            pdf.drawString(safe_left + 3 * mm, box_y + 3 * mm, "Ticket")
            pdf.setFillColor(text_color)
            pdf.setFont("Helvetica-Bold", 8)
            pdf.drawString(28 * mm, box_y + 15 * mm, booking_number)
            seat_size = fit_text(seat_label, "Helvetica-Bold", 8, 6.5, safe_right - 28 * mm)
            pdf.setFont("Helvetica-Bold", seat_size)
            pdf.drawString(28 * mm, box_y + 9 * mm, seat_label)
            pdf.setFont("Helvetica-Bold", 8)
            pdf.drawString(28 * mm, box_y + 3 * mm, f"{ticket.get('index', position + 1)} von {len(tickets)}")

        if not background_path:
            pdf.setStrokeColor(colors.HexColor("#aaa4a8"))
            pdf.setDash(2, 2)
            pdf.line(0, perforation_y, page_width, perforation_y)
            pdf.setDash()
            pdf.setFillColor(text_color)
            pdf.setFont("Helvetica-Bold", 8.5)
            pdf.drawString(safe_left, 17 * mm, event_title[:34])
            pdf.setFillColor(muted)
            pdf.setFont("Helvetica", 6.5)
            pdf.drawString(safe_left, 11 * mm, f"{date_text} · {time_text} Uhr · Ticket {ticket.get('index', position + 1)}")
            pdf.drawRightString(safe_right, 6 * mm, token[:10].upper())

        pdf.setSubject(f"Boulevardtheater Ticket {ticket.get('index', position + 1)} von {len(tickets)}")
        pdf.showPage()

    pdf.save()
    overlay_bytes = buffer.getvalue()

    if background_path and background_mime_type == "application/pdf":
        try:
            vendor_dir = Path(__file__).resolve().parent / "_vendor"
            if str(vendor_dir) not in sys.path:
                sys.path.insert(0, str(vendor_dir))
            from pypdf import PdfReader, PdfWriter
        except ImportError as exc:
            raise RuntimeError("Die integrierte PDF-Vorlagen-Unterstützung konnte nicht geladen werden.") from exc

        background_reader = PdfReader(str(background_path))
        overlay_reader = PdfReader(BytesIO(overlay_bytes))
        if not background_reader.pages:
            raise RuntimeError("Die hinterlegte Ticket-PDF-Vorlage enthält keine Seite.")
        writer = PdfWriter()
        for overlay_page in overlay_reader.pages:
            base_page = copy.deepcopy(background_reader.pages[0])
            base_page.merge_page(overlay_page)
            writer.add_page(base_page)
        merged = BytesIO()
        writer.write(merged)
        return merged.getvalue()

    return overlay_bytes

def smtp_send_message(message):
    validate_offline_mail_configuration()
    tls_context = ssl.create_default_context()
    if SMTP_SECURITY == "ssl":
        smtp = smtplib.SMTP_SSL(SMTP_HOST, SMTP_PORT, timeout=20, context=tls_context)
    else:
        smtp = smtplib.SMTP(SMTP_HOST, SMTP_PORT, timeout=20)
    with smtp:
        smtp.ehlo()
        if SMTP_SECURITY == "starttls":
            smtp.starttls(context=tls_context)
            smtp.ehlo()
        if SMTP_USERNAME:
            smtp.login(SMTP_USERNAME, SMTP_PASSWORD)
        smtp.send_message(message)


