def normalize_ticket_layout_settings(raw_settings=None):
    raw_settings = raw_settings if isinstance(raw_settings, dict) else {}
    layout = dict(TICKET_LAYOUT_DEFAULTS)
    for key in ("qr_x_mm", "qr_y_mm", "qr_size_mm"):
        try:
            layout[key] = float(raw_settings.get(key, layout[key]))
        except (TypeError, ValueError):
            layout[key] = float(TICKET_LAYOUT_DEFAULTS[key])
    layout["qr_x_mm"] = min(85.0, max(0.0, layout["qr_x_mm"]))
    layout["qr_y_mm"] = min(195.0, max(28.0, layout["qr_y_mm"]))
    layout["qr_size_mm"] = min(60.0, max(18.0, layout["qr_size_mm"]))
    layout["show_ticket_data"] = bool(raw_settings.get("show_ticket_data", layout["show_ticket_data"]))
    return layout


def detect_ticket_template_format(content: bytes):
    if content.startswith(b"%PDF-"):
        return "pdf", "application/pdf"
    if content.startswith(b"\x89PNG\r\n\x1a\n"):
        return "png", "image/png"
    if content.startswith(b"\xff\xd8\xff"):
        return "jpg", "image/jpeg"
    return None


def ticket_template_path(filename: str):
    filename = str(filename or "")
    if not TICKET_TEMPLATE_FILENAME_PATTERN.fullmatch(filename):
        return None
    path = TICKET_TEMPLATE_DIR / filename
    return path if path.is_file() else None


