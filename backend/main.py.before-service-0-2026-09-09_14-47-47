def invoice_ticket_split(context):
    """Liefert die steuerliche Aufteilung je einzelner Eintrittskarte."""
    raw_items = context.get("price_items") or []
    by_category = {
        str(item.get("category")): item
        for item in raw_items
        if isinstance(item, dict)
        and item.get("category") in {"ticket", "food", "drink"}
    }
    if not by_category:
        return None

    defaults = (
        ("ticket", "Eintrittskarte"),
        ("food", "Essen / Menü"),
        ("drink", "Getränke"),
    )
    rows = []
    for category, default_name in defaults:
        item = by_category.get(category, {})
        gross = Decimal(str(item.get("gross_amount", 0) or 0)).quantize(
            Decimal("0.01"),
            rounding=ROUND_HALF_UP,
        )
        vat_rate = Decimal(str(item.get("vat_rate", 0) or 0))
        divisor = Decimal("1") + vat_rate / Decimal("100")
        net = (gross / divisor).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
        tax = gross - net
        rows.append(
            {
                "category": category,
                "name": str(item.get("name") or default_name).strip() or default_name,
                "gross": gross,
                "net": net,
                "tax": tax,
                "vat_rate": vat_rate,
                "provider_type": str(item.get("provider_type") or "internal"),
                "provider_name": str(item.get("provider_name") or "").strip(),
                "configured": bool(item),
            }
        )

    total_gross = sum((row["gross"] for row in rows), Decimal("0"))
    if total_gross <= 0:
        return None
    return {
        "rows": rows,
        "net": sum((row["net"] for row in rows), Decimal("0")),
        "tax": sum((row["tax"] for row in rows), Decimal("0")),
        "gross": total_gross,
    }


def invoice_front_ticket_description(context):
    template = context.get("template") or {}
    item = next(
        (
            candidate
            for candidate in template.get("items", [])
            if isinstance(candidate, dict) and candidate.get("source") == "tickets"
        ),
        {},
    )
    description = str(item.get("description") or "Eintrittskarte")
    event_date = context.get("event_date")
    date_text = (
        f"{event_date.day}.{event_date.month}.{event_date.year}"
        if event_date
        else "—"
    )
    description = description.replace("{{event_title}}", str(context.get("event_title") or "Veranstaltung"))
    description = description.replace("{{event_date}}", date_text)
    if (
        item.get("append_event_details")
        and "{{event_title}}" not in str(item.get("description", ""))
        and "{{event_date}}" not in str(item.get("description", ""))
    ):
        description = (
            f"{description or 'Eintrittskarte'} – "
            f"{context.get('event_title') or 'Veranstaltung'} am {date_text}"
        )
    return description[:500]


def invoice_front_items(context):
    """
    Für die sichtbare Vorderseite werden Eintritt/Essen/Getränke wieder zu
    genau einer normalen Ticketposition zusammengefasst. Die gespeicherten
    Rechnungszeilen bleiben für die korrekte Steuerberechnung unverändert.
    """
    items = list(context.get("items") or [])
    split = invoice_ticket_split(context)
    if not split:
        return items

    configured_names = {
        row["name"].strip().casefold()
        for row in split["rows"]
        if row["configured"] and row["gross"] > 0
    }
    if not configured_names:
        return items

    matching_indexes = [
        index
        for index, item in enumerate(items)
        if str(item.get("description") or "").strip().casefold() in configured_names
    ]
    # Nur automatisch erzeugte Komponenten zusammenfassen. Bei frei
    # bearbeiteten/manualen Rechnungen bleibt die Vorderseite unverändert.
    if len(matching_indexes) < len(configured_names):
        return items

    first_index = min(matching_indexes)
    hidden = set(matching_indexes)
    ticket_count = Decimal(str(context.get("ticket_count") or 1))
    combined = {
        "position_no": 0,
        "description": invoice_front_ticket_description(context),
        "quantity": ticket_count,
        "unit_gross": split["gross"],
        "tax_rate": Decimal("0"),
        "net": split["net"] * ticket_count,
        "tax": split["tax"] * ticket_count,
        "gross": split["gross"] * ticket_count,
        "tax_label": "siehe Seite 2",
    }

    result = []
    for index, item in enumerate(items):
        if index == first_index:
            result.append(combined)
        if index not in hidden:
            result.append(item)
    return result


def euro_text(value):
    amount = Decimal(str(value or 0)).quantize(Decimal("0.01"), ROUND_HALF_UP)
    return f"{amount:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".") + " EUR"


