                    s.table_seat_number,
                    sa.id,
                    sa.booking_id,
                    sa.status,
                    b.booking_number,
                    b.status,
                    c.first_name,
                    c.last_name,
                    tp.token,
                    tp.checked_in_at,
                    checkin_user.display_name
                FROM seats s
                LEFT JOIN seat_assignments sa
                    ON sa.seat_id = s.id
                   AND sa.performance_id = %s
                LEFT JOIN bookings b ON b.id = sa.booking_id
                LEFT JOIN customers c ON c.id = b.customer_id
                LEFT JOIN ticket_passes tp
                    ON tp.booking_id = b.id
                   AND tp.seat_id = s.id
                LEFT JOIN app_users checkin_user
                    ON checkin_user.id = tp.checked_in_by_user_id
                WHERE s.is_active = TRUE
                  AND {seat_filter}
                ORDER BY
                    COALESCE(s.table_number, s.row_number),
                    COALESCE(s.table_seat_number, s.seat_number),
                    s.id
                """,
                (performance_id,),
            )
            seat_rows = cur.fetchall()

            cur.execute(
                """
                SELECT
                    COALESCE(SUM(b.ticket_count), 0),
                    COALESCE(SUM(CASE WHEN LOWER(COALESCE(b.status, '')) = 'storniert' THEN b.ticket_count ELSE 0 END), 0)
                FROM bookings b
                WHERE b.performance_id = %s
                """,
                (performance_id,),
            )
            booking_totals = cur.fetchone()
            cur.execute(
                """
                SELECT COUNT(*)
                FROM ticket_passes tp
                JOIN bookings b ON b.id = tp.booking_id
                WHERE b.performance_id = %s
                  AND tp.checked_in_at IS NOT NULL
                  AND LOWER(COALESCE(b.status, 'reserviert')) <> 'storniert'
                """,
                (performance_id,),
            )
            checked_in_total = int(cur.fetchone()[0] or 0)

    seats = []
    for row in seat_rows:
        booking_status = str(row[11] or "").lower()
        is_cancelled = booking_status in {"storniert", "storno"}
        seats.append(
            {
                "seat_id": int(row[0]),
                "row_number": row[1],
                "seat_number": row[2],
                "side": row[3] or "",
                "hall_type": row[4] or "",
                "table_number": row[5],
                "table_seat_number": row[6],
                "assignment_id": int(row[7]) if row[7] is not None else None,
                "booking_id": int(row[8]) if row[8] is not None else None,
                "assignment_status": row[9] or "",
                "booking_number": row[10] or "",
                "booking_status": row[11] or "",
                "customer_name": f"{row[12] or ''} {row[13] or ''}".strip(),
                "has_ticket": bool(row[14]),
                "checked_in": bool(row[15]) and not is_cancelled,
                "checked_in_at": row[15].isoformat() if row[15] else None,
                "checked_in_by": row[16] or "",
                "cancelled": is_cancelled,
            }
        )

    return {
        "performance": {
            "id": int(performance[0]),
            "title": performance[1] or "",
            "performance_date": performance[2].isoformat() if performance[2] else None,
            "start_time": performance[3].isoformat() if performance[3] else None,
            "venue_name": performance[4] or "",
            "hall_plan_type": hall_plan_type,
        },
        "summary": {
            "booked_tickets": int(booking_totals[0] or 0),
            "cancelled_tickets": int(booking_totals[1] or 0),
            "checked_in_tickets": checked_in_total,
        },
        "seats": seats,
    }


@app.post("/api/checkin/scan")
def scan_ticket_for_checkin(data: CheckinScanRequest, request: Request):
    actor = require_checkin_access(request)
    token = normalize_ticket_scan_token(data.token)

    with psycopg.connect(DB_CONFIG) as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT
                    tp.id,
                    tp.ticket_index,
                    tp.checked_in_at,
                    tp.checked_in_by_user_id,
                    b.id,
                    b.booking_number,
                    b.status,
                    b.customer_id,
                    b.ticket_count,
                    b.performance_id,
                    p.title,
                    p.performance_date,
                    p.start_time,
                    p.venue_name,
                    tp.seat_id,
                    s.row_number,
                    s.seat_number,
                    s.hall_type,
                    s.table_number,
                    s.table_seat_number,
                    c.first_name,
                    c.last_name,
                    previous_user.display_name
                FROM ticket_passes tp
                JOIN bookings b ON b.id = tp.booking_id
                JOIN performances p ON p.id = b.performance_id
                JOIN customers c ON c.id = b.customer_id
                LEFT JOIN seats s ON s.id = tp.seat_id
                LEFT JOIN app_users previous_user
                    ON previous_user.id = tp.checked_in_by_user_id
                WHERE tp.token = %s
                LIMIT 1
                FOR UPDATE OF tp
                """,
                (token,),
            )
            row = cur.fetchone()
            if not row:
                raise HTTPException(status_code=404, detail="Ticket nicht gefunden.")

            if data.performance_id is not None and int(row[9]) != int(data.performance_id):
                return checkin_ticket_payload(
                    row,
                    status="wrong_event",
                    message="Dieses Ticket gehört zu einer anderen Veranstaltung.",
                )

            if str(row[6] or "").lower() in {"storniert", "storno"}:
                cur.execute(
                    """
                    UPDATE ticket_passes
                    SET last_scan_at = CURRENT_TIMESTAMP,
                        checkin_count = checkin_count + 1,
                        updated_at = CURRENT_TIMESTAMP
                    WHERE id = %s
                    """,
                    (row[0],),
                )
                conn.commit()
                return checkin_ticket_payload(
                    row,
                    status="cancelled",
                    message="Dieses Ticket ist storniert und nicht gültig.",
                )

            if row[2] is not None:
                cur.execute(
                    """
                    UPDATE ticket_passes
                    SET last_scan_at = CURRENT_TIMESTAMP,
                        checkin_count = checkin_count + 1,
                        updated_at = CURRENT_TIMESTAMP
                    WHERE id = %s
                    """,
                    (row[0],),
                )
                conn.commit()
                return checkin_ticket_payload(
                    row,
                    status="already_checked_in",
                    message="Dieses Ticket wurde bereits eingecheckt.",
                )

            cur.execute(
                """
                UPDATE ticket_passes
                SET checked_in_at = CURRENT_TIMESTAMP,
                    checked_in_by_user_id = %s,
                    last_scan_at = CURRENT_TIMESTAMP,
                    checkin_count = checkin_count + 1,
                    updated_at = CURRENT_TIMESTAMP
                WHERE id = %s
                RETURNING checked_in_at
                """,
                (actor["user_id"], row[0]),
            )
            checked_in_at = cur.fetchone()[0]

            scanned_seat = (
                {
                    "row_number": row[15],
                    "seat_number": row[16],
                    "hall_type": row[17] or "",
                    "table_number": row[18],
                    "table_seat_number": row[19],
                }
                if row[14]
                else None
            )
            write_activity(
                cur,
                request,
                action="Ticket eingecheckt",
                entity_type="ticket_pass",
                entity_id=row[0],
                customer_id=row[7],
                performance_id=row[9],
                booking_id=row[4],
                description=(
                    f"{row[20]} {row[21]} · {row[5]} · "
                    f"Ticket {row[1]} von {row[8]} · "
                    f"{ticket_seat_label(scanned_seat)}"
                ),
                new_value=f"checked_in_by={actor['display_name']}",
            )
            conn.commit()

    updated = list(row)
    updated[2] = checked_in_at
    updated[22] = actor["display_name"]
    return checkin_ticket_payload(
        updated,
        status="checked_in",
        message="Ticket gültig – Check-in erfolgreich.",
    )


