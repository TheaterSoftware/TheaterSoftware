def assign_staff_booking_seats(
    cur,
    booking_id: int,
    performance_id: int,
    ticket_count: int,
    hall_plan_type: str,
):
    """Weist einer bezahlten Personalplatz-Buchung passende freie Plätze zu."""
    seat_filter = public_seat_filter(hall_plan_type)

    cur.execute(
        """
        SELECT
            s.id,
            COALESCE(s.table_number, s.row_number),
            COALESCE(s.table_seat_number, s.seat_number)
        FROM seat_assignments sa
        JOIN seats s ON s.id = sa.seat_id
        WHERE sa.performance_id = %s
        AND sa.booking_id = %s
        AND LOWER(COALESCE(sa.status, 'reserviert')) <> 'storniert'
        ORDER BY
            COALESCE(s.table_number, s.row_number),
            COALESCE(s.table_seat_number, s.seat_number),
            s.id
        """,
        (performance_id, booking_id),
    )
    existing_rows = cur.fetchall()
    remaining = max(0, int(ticket_count) - len(existing_rows))
    if remaining == 0:
        return []

    cur.execute(
        f"""
        SELECT
            s.id,
            COALESCE(s.table_number, s.row_number) AS seat_group,
            COALESCE(s.table_seat_number, s.seat_number) AS seat_position
        FROM seats s
        WHERE s.is_active = TRUE
        AND {seat_filter}
        AND NOT EXISTS (
            SELECT 1
            FROM seat_assignments sa
            WHERE sa.performance_id = %s
            AND sa.seat_id = s.id
            AND LOWER(COALESCE(sa.status, 'reserviert')) <> 'storniert'
        )
        ORDER BY seat_group, seat_position, s.id
        FOR UPDATE OF s
        """,
        (performance_id,),
    )
    available_rows = cur.fetchall()
    if len(available_rows) < remaining:
        print(
            "Automatische Platzvergabe nicht möglich: "
            f"Buchung {booking_id} benötigt {remaining} weitere Plätze, "
            f"aber nur {len(available_rows)} sind frei."
        )
        return []

    seats_by_group = {}
    for row in available_rows:
        seats_by_group.setdefault(row[1], []).append(row)

    chosen_rows = []
    preferred_groups = []
    if existing_rows:
        preferred_groups.append(existing_rows[0][1])

    for group_id in preferred_groups:
        group_rows = seats_by_group.get(group_id, [])
        take = min(remaining - len(chosen_rows), len(group_rows))
        chosen_rows.extend(group_rows[:take])
        seats_by_group[group_id] = group_rows[take:]

    still_needed = remaining - len(chosen_rows)
    if still_needed > 0:
        matching_group = next(
            (
                group_rows
                for group_rows in seats_by_group.values()
                if len(group_rows) >= still_needed
            ),
            None,
        )
        if matching_group is not None:
            chosen_rows.extend(matching_group[:still_needed])
        else:
            for group_rows in seats_by_group.values():
                if len(chosen_rows) >= remaining:
                    break
                take = min(remaining - len(chosen_rows), len(group_rows))
                chosen_rows.extend(group_rows[:take])

    chosen_ids = [int(row[0]) for row in chosen_rows[:remaining]]
    if len(chosen_ids) != remaining:
        return []

    for seat_id in chosen_ids:
        cur.execute(
            """
            INSERT INTO seat_assignments (
                performance_id,
                seat_id,
                booking_id,
                status
            )
            VALUES (%s, %s, %s, 'bezahlt')
            """,
            (performance_id, seat_id, booking_id),
        )

    return chosen_ids


def backfill_paid_online_staff_seats():
    """Trägt bereits bezahlte Online-Buchungen ohne Personalplätze nach."""
    assigned_total = 0
    try:
        with psycopg.connect(DB_CONFIG) as conn:
            with conn.cursor() as cur:
                cur.execute(
                    """
                    SELECT
                        b.id,
                        b.performance_id,
                        b.ticket_count,
                        p.hall_plan_type
                    FROM bookings b
                    JOIN performances p ON p.id = b.performance_id
                    WHERE b.stripe_checkout_session_id IS NOT NULL
                    AND LOWER(COALESCE(b.status, '')) = 'bezahlt'
                    AND p.seating_mode = 'staff_assigned'
                    ORDER BY b.performance_id, b.id
                    """
                )
                bookings_to_assign = cur.fetchall()

                for (
                    booking_id,
                    performance_id,
                    ticket_count,
                    hall_plan_type,
                ) in bookings_to_assign:
                    cur.execute(
                        "SELECT pg_advisory_xact_lock(%s)",
                        (900000000000 + int(performance_id),),
                    )
                    assigned_total += len(
                        assign_staff_booking_seats(
                            cur,
                            int(booking_id),
                            int(performance_id),
                            int(ticket_count),
                            hall_plan_type or "hall_1",
                        )
                    )

                conn.commit()
    except Exception as exc:
        print(f"Automatische Nachtragung der Online-Plätze fehlgeschlagen: {exc}")
        return

    if assigned_total > 0:
        print(
            f"Automatische Platzvergabe: {assigned_total} "
            "bezahlte Online-Plätze nachgetragen."
        )


