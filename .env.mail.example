# OFFLINE-TESTBETRIEB
# Diese Adresse ist im Offline-Update der einzige tatsächliche Empfänger.
EMAIL_TEST_RECIPIENT=DEINE_TESTADRESSE@example.com

# Absender des Theater-Postfachs
EMAIL_FROM_NAME=Boulevardtheater Deidesheim
EMAIL_FROM_ADDRESS=info@boulevard-deidesheim.de

# SMTP-Daten deines Mailanbieters. Das Passwort niemals verschicken.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=info@boulevard-deidesheim.de
SMTP_PASSWORD=HIER_NUR_LOKAL_EINTRAGEN
